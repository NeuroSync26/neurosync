# Copy to .env for local runs (never commit .env). On Render, set these in the service's Environment tab.

# Gemini (Google AI Studio). Main + backup key; main + fallback model (use current, non-deprecated model names)
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=
GEMINI_MODEL_FALLBACK=
# Optional, default 0
GEMINI_TEMPERATURE=

# Supabase (persistent storage). Service role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=report-photos

# OpenStreetMap Nominatim requires an identifying User-Agent
NOMINATIM_USER_AGENT=

# Optional: official department names with their published source, e.g.
# {"sanitation":{"name":"...","source":"https://..."}}
DEPARTMENTS_JSON=

# Set automatically by Render
PORT=
